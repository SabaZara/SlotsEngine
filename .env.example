# Copy to infra/.env (or export) before starting anything.
# The services refuse to boot if the secrets below are missing or too
# short — see apps/game-backend/src/startupGuards.ts for why that is a
# deliberate refusal rather than a warning.

# --- Database -------------------------------------------------------------
# A replica set is required, not optional: the money path runs debit,
# evaluate, credit and round-insert inside one transaction, and Mongo only
# offers transactions on a replica set.
#
# `mongo:27017` is the IN-NETWORK address, which is what the services use.
# Leave this commented out unless you are pointing the stack at a different
# database — compose supplies exactly this value as the default.
#
# NOTE the missing `directConnection=true`, which this line used to carry
# and which was wrong here. That flag suppresses replica-set topology
# discovery and makes the driver talk to one node as if it were a
# standalone. It is needed only when connecting from the HOST (see below),
# because the set advertises itself as `mongo:27017` — a name that does not
# resolve outside the Docker network. From inside, the advertisement is
# correct and following it is what keeps transactions working across a
# failover, so the flag would quietly remove a guarantee the money path
# depends on.
#MONGO_URI=mongodb://mongo:27017/slots_engine?replicaSet=rs0
MONGO_DB=slots_engine

# Connecting from the HOST — a `mongosh`, or the conformance and ledger
# suites, which reach the container through its published port. This is
# where `directConnection=true` is required and correct: without it the
# driver reads the set's advertised `mongo:27017` and fails to resolve it.
# The suites default to exactly this, so it only needs setting if
# MONGO_HOST_PORT below is changed.
#MONGO_TEST_URI=mongodb://localhost:27018/?directConnection=true

# --- Secrets --------------------------------------------------------------
# Generate real values with:  openssl rand -hex 32
# These two must be DIFFERENT from each other in production.

# Signs internal service-to-service calls. Without this, anything able to
# reach game-backend could spin as any player.
SERVICE_AUTH_SECRET=dev-only-service-secret-change-me-in-production-abc123

# Signs player launch and session tokens.
LAUNCH_TOKEN_SECRET=dev-only-launch-secret-change-me-in-production-xyz789

# --- Object storage -------------------------------------------------------
# Game artwork and audio. The bucket is PRIVATE: every read is a signed URL
# minted at serve time, so a leaked URL stops working within the day.
#
# ASSET_ENDPOINT is the address SERVICES use (in-network);
# ASSET_PUBLIC_ENDPOINT is the one a BROWSER uses. They must differ, because
# a signature is computed against the host the request is actually made to —
# a URL signed against `minio:9000` fails when fetched from `localhost`.
#ASSET_ENDPOINT=http://minio:9000
#ASSET_PUBLIC_ENDPOINT=http://localhost:9010
ASSET_ACCESS_KEY=dev-asset-key
ASSET_SECRET_KEY=dev-asset-secret-change-me
#ASSET_BUCKET=game-assets
# Host ports, configurable so this stack can run beside another one.
#ASSET_HOST_PORT=9010
#ASSET_CONSOLE_PORT=9011

# --- Services -------------------------------------------------------------
GAME_BACKEND_URL=http://game-backend:9002
LOG_LEVEL=info
NODE_ENV=development

# --- Development conveniences --------------------------------------------
# Free starting balance for a player seen for the first time, in minor
# units (100000 = 1000.00). Startup guards REFUSE to boot with this set
# above zero when NODE_ENV=production.
INITIAL_PLAYER_BALANCE=100000

# --- Host port mapping ----------------------------------------------------
# Container ports are fixed; these only control what the host exposes, so
# this stack can run beside another one without a clash.
MONGO_HOST_PORT=27018
GAME_BACKEND_HOST_PORT=9102
GAME_SOCKET_HOST_PORT=9103

# --- Backoffice -----------------------------------------------------------
# Signs admin session tokens. Must differ from the two secrets above.
# Generate with: openssl rand -hex 32
BACKOFFICE_JWT_SECRET=dev-only-backoffice-secret-change-me-in-prod-def456

# Browser origin the admin UI is served from. Never "*" — these routes
# carry a bearer token.
BACKOFFICE_CORS_ORIGINS=http://localhost:9106

# The first administrator, seeded only when no users exist at all.
# In production this password is REQUIRED; the service refuses to seed a
# default credential.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- Public URLs ----------------------------------------------------------
# Baked into the frontend bundle at build time, so these must be reachable
# from a BROWSER — host ports, not internal Docker service names.
PUBLIC_GAME_BACKEND_URL=http://localhost:9102
PUBLIC_GAME_SOCKET_URL=ws://localhost:9103

BACKOFFICE_API_HOST_PORT=9105
GAME_FRONTEND_HOST_PORT=9104

# Browser origin the game client is served from. Only /public/games/:id is
# exposed cross-origin; the internal API never gets a CORS header.
GAME_CORS_ORIGINS=http://localhost:9104

# Origins allowed to open a game-socket WebSocket. Defaults to
# GAME_CORS_ORIGINS when unset, so the HTTP and socket surfaces stay
# configured together. Required in production; '*' is refused outright.
# A client that sends no Origin header at all (any non-browser caller) is
# allowed — only browsers send one, and only browsers cannot forge it.
SOCKET_ALLOWED_ORIGINS=http://localhost:9104

# --- Backoffice UI --------------------------------------------------------
# Baked into the admin bundle at build time, so it must be reachable from a
# BROWSER — the host port, not the internal service name.
PUBLIC_BACKOFFICE_API_URL=http://localhost:9105
BACKOFFICE_FRONTEND_HOST_PORT=9106

# --- Rate limiting -------------------------------------------------------
# Requests per minute. game-backend keys /internal by service caller and
# /public by IP; health is exempt so a limiter can never fail a probe.
GAME_RATE_LIMIT=600
BACKOFFICE_RATE_LIMIT=300

# Per-account login throttling, which the per-IP limit above cannot do:
# an attacker spread across many addresses gets the full IP allowance from
# each one. Counted against the attempted email after the body is parsed.
# Consecutive failures before the account is locked.
LOGIN_MAX_ATTEMPTS=10
# How long the lock lasts, and how long a run of failures is remembered.
# The window matters: without it, a handful of typos months apart would
# eventually add up to a lockout.
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Login is far tighter than ordinary admin traffic — 300 guesses a minute
# is a working credential-stuffing rate, not a defence. Per 5 minutes.
LOGIN_RATE_LIMIT=10

# game-socket uses per-connection token buckets rather than a fixed window,
# so a client cannot spend two full allowances across a window boundary.
# Spins are limited tightly because each one is a database transaction.
SOCKET_SPIN_RATE=5
SOCKET_SPIN_BURST=10
SOCKET_MSG_RATE=25
SOCKET_MSG_BURST=50
SOCKET_MAX_CONNECTIONS=5000
